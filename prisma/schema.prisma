generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  users           User[]
}

model Permission {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model User {
  id                     String               @id @default(uuid())
  email                  String               @unique
  passwordHash           String
  name                   String
  roleId                 String
  active                 Boolean              @default(true)
  deletedAt              DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  failedLoginAttempts    Int                  @default(0)
  lockedUntil            DateTime?
  mustChangePassword     Boolean              @default(false)
  phone                  String?              @unique
  totpEnabled            Boolean              @default(false)
  totpSecret             String?
  auditLogs              AuditLog[]
  passwordResetTokens    PasswordResetToken[]
  paymentRequestsCreated PaymentRequest[]     @relation("PaymentRequestCreator")
  receiptsCashiered      Receipt[]            @relation("ReceiptCashier")
  receiptsVoided         Receipt[]            @relation("ReceiptVoider")
  sessions               Session[]
  staff                  Staff?
  housekeepingTasksAssigned HousekeepingTask[]   @relation("HousekeepingAssignee")
  folioChargesCreated       FolioCharge[]        @relation("FolioChargeCreator")
  role                   Role                 @relation(fields: [roleId], references: [id])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  tokenHash    String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
}

model Customer {
  id                 String    @id @default(uuid())
  phone              String    @unique
  name               String
  email              String?
  notes              String?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  allergies          String?
  anonymizedAt       DateTime?
  isAnonymized       Boolean   @default(false)
  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime?
  preferences        String?
  birthdayMonth      Int?
  birthdayDay        Int?
  tags               String[]      @default([])
  idType             String?
  idNumber           String?
  nationality        String?
  company            String?
  vehiclePlate       String?
  bookings           Booking[]
  receipts           Receipt[]
  reservations       Reservation[]

  @@index([phone])
  @@index([isAnonymized])
  @@index([deletedAt])
}

model ServiceCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  order       Int       @default(0)
  services    Service[]
}

model Service {
  id            String          @id @default(uuid())
  categoryId    String
  name          String
  description   String?
  durationMin   Int
  bufferMin     Int             @default(0)
  pricePesewas  Int
  depositType   DepositType     @default(PERCENTAGE)
  depositValue  Int             @default(30)
  active        Boolean         @default(true)
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  imageUrl      String?
  order         Int             @default(0)
  bookingItems  BookingItem[]
  category      ServiceCategory @relation(fields: [categoryId], references: [id])
  addons        ServiceAddon[]
  staffServices StaffService[]
}

model ServiceAddon {
  id           String   @id @default(uuid())
  serviceId    String
  name         String
  durationMin  Int      @default(0)
  pricePesewas Int
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Staff {
  id            String          @id @default(uuid())
  userId        String?         @unique
  name          String
  phone         String?
  bio           String?
  active        Boolean         @default(true)
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  photoUrl      String?
  specialties   String[]        @default([])
  blockedTimes  BlockedTime[]
  bookings      Booking[]
  slotHolds     SlotHold[]
  user          User?           @relation(fields: [userId], references: [id])
  schedules     StaffSchedule[]
  staffServices StaffService[]
  timeOffs      TimeOff[]
}

model StaffService {
  id        String   @id @default(uuid())
  staffId   String
  serviceId String
  createdAt DateTime @default(now())
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceId])
}

model StaffSchedule {
  id         String   @id @default(uuid())
  staffId    String
  weekday    Int
  startTime  String
  endTime    String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  breakEnd   String?
  breakStart String?
  isDayOff   Boolean  @default(false)
  label      String?
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, weekday])
}

model TimeOff {
  id        String   @id @default(uuid())
  staffId   String
  startUtc  DateTime
  endUtc    DateTime
  reason    String?
  createdAt DateTime @default(now())
  approved  Boolean  @default(true)
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, startUtc, endUtc])
}

model BlockedTime {
  id        String   @id @default(uuid())
  staffId   String
  startUtc  DateTime
  endUtc    DateTime
  reason    String?
  createdAt DateTime @default(now())
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, startUtc, endUtc])
}

model Booking {
  id                     String           @id @default(uuid())
  reference              String           @unique
  status                 BookingStatus    @default(PENDING_PAYMENT)
  source                 BookingSource    @default(WEB)
  startUtc               DateTime
  endUtc                 DateTime
  staffId                String
  customerId             String
  subtotalPesewas        Int
  discountPesewas        Int              @default(0)
  totalPesewas           Int
  depositRequiredPesewas Int              @default(0)
  amountPaidPesewas      Int              @default(0)
  notes                  String?
  manageTokenHash        String           @unique
  deletedAt              DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  manageTokenEncrypted   String?
  customer               Customer         @relation(fields: [customerId], references: [id])
  staff                  Staff            @relation(fields: [staffId], references: [id])
  items                  BookingItem[]
  payments               Payment[]
  paymentRequests        PaymentRequest[]
  receipts               Receipt[]
  Refund                 Refund[]

  @@index([reference])
  @@index([customerId])
  @@index([staffId])
  @@index([startUtc, endUtc])
  @@index([status])
}

model BookingItem {
  id           String   @id @default(uuid())
  bookingId    String
  serviceId    String
  pricePesewas Int
  durationMin  Int
  createdAt    DateTime @default(now())
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service      Service  @relation(fields: [serviceId], references: [id])
}

model SlotHold {
  id            String   @id @default(uuid())
  token         String   @unique
  staffId       String
  serviceId     String
  startUtc      DateTime
  endUtc        DateTime
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  addonIds      String[] @default([])
  extendedCount Int      @default(0)
  serviceIds    String[] @default([])
  staff         Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, startUtc, endUtc])
  @@index([expiresAt])
}

model Payment {
  id                String           @id @default(uuid())
  bookingId         String?
  reference         String           @unique
  amountPesewas     Int
  currency          String           @default("GHS")
  status            PaymentStatus    @default(PENDING)
  channel           String
  providerReference String?
  paidAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  receiptId         String?
  booking           Booking?         @relation(fields: [bookingId], references: [id])
  receipt           Receipt?         @relation(fields: [receiptId], references: [id])
  paymentRequests   PaymentRequest[]
  refunds           Refund[]

  @@index([reference])
  @@index([bookingId])
  @@index([receiptId])
}

model PaymentRequest {
  id                String               @id @default(uuid())
  bookingId         String
  amountPesewas     Int
  phone             String
  channel           String               @default("ALL")
  paystackReference String?              @unique
  createdAt         DateTime             @default(now())
  cancelledAt       DateTime?
  createdByUserId   String?
  currency          String               @default("GHS")
  expiresAt         DateTime
  message           String?
  momoProvider      String?
  paidAt            DateTime?
  paymentId         String?
  pushMomo          Boolean              @default(false)
  shortCode         String?              @unique
  tokenHash         String               @unique
  updatedAt         DateTime             @updatedAt
  viewedAt          DateTime?
  status            PaymentRequestStatus @default(PENDING)
  booking           Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdByUser     User?                @relation("PaymentRequestCreator", fields: [createdByUserId], references: [id])
  payment           Payment?             @relation(fields: [paymentId], references: [id])

  @@index([bookingId])
  @@index([status])
  @@index([expiresAt])
}

model ProcessedWebhook {
  id          String   @id @default(uuid())
  eventId     String   @unique
  eventType   String
  payload     Json?
  processedAt DateTime @default(now())

  @@index([eventId])
}

model Refund {
  id                String   @id @default(uuid())
  paymentId         String?
  amountPesewas     Int
  reason            String   @default("Customer refund")
  status            String   @default("COMPLETED")
  processedByUserId String?
  createdAt         DateTime @default(now())
  bookingId         String?
  channel           String   @default("PAYSTACK")
  currency          String   @default("GHS")
  providerRefundId  String?
  updatedAt         DateTime @default(now())
  Booking           Booking? @relation(fields: [bookingId], references: [id])
  payment           Payment? @relation(fields: [paymentId], references: [id])

  @@index([bookingId])
  @@index([paymentId])
  @@index([status])
}

model PromoCode {
  id            String    @id @default(uuid())
  code          String    @unique
  discountType  String
  discountValue Int
  active        Boolean   @default(true)
  validUntil    DateTime?
  maxUses       Int?
  usedCount     Int       @default(0)
  createdAt     DateTime  @default(now())
}

model MessageLog {
  id                  String    @id @default(uuid())
  recipient           String
  senderId            String?   @default("Glamour")
  content             String
  status              String
  gatewayId           String?
  bookingId           String?
  createdAt           DateTime  @default(now())
  channel             String    @default("SMS")
  deliveredAt         DateTime?
  error               String?
  subject             String?
  costEstimatePesewas Int?
  encoding            String?
  event               String?
  failedAt            DateTime?
  idempotencyKey      String?   @unique
  maxRetries          Int       @default(3)
  metadata            Json?
  nextRetryAt         DateTime?
  retryCount          Int       @default(0)
  segmentCount        Int?
  updatedAt           DateTime  @updatedAt

  @@index([recipient])
  @@index([bookingId])
  @@index([status])
}

model MessageTemplate {
  id          String   @id @default(uuid())
  slug        String   @unique
  template    String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  active      Boolean  @default(true)
  channel     String   @default("SMS")
  name        String?
  subject     String?
  event       String
  variables   String[] @default([])

  @@index([event, channel])
}

model NotificationJob {
  id             String    @id @default(uuid())
  channel        String
  recipient      String
  payload        Json
  status         String    @default("PENDING")
  runAt          DateTime  @default(now())
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  lastError      String?
  bookingId      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  event          String
  idempotencyKey String    @unique
  jobType        String    @default("NOTIFICATION")
  processedAt    DateTime?

  @@index([status, runAt])
  @@index([bookingId, event])
}

model InAppNotification {
  id        String    @id @default(uuid())
  userId    String?
  title     String
  message   String
  type      String    @default("INFO")
  link      String?
  read      Boolean   @default(false)
  createdAt DateTime  @default(now())
  bookingId String?
  readAt    DateTime?

  @@index([userId, read])
  @@index([createdAt])
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model ReceiptCounter {
  id         String   @id @default(uuid())
  prefix     String   @unique
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model Receipt {
  id                String    @id @default(uuid())
  receiptNumber     String    @unique
  bookingId         String?
  customerId        String?
  cashierId         String
  customerName      String
  customerPhone     String
  subtotalPesewas   Int
  discountPesewas   Int       @default(0)
  discountPercent   Float?
  discountReason    String?
  promoCode         String?
  tipPesewas        Int       @default(0)
  totalPesewas      Int
  amountPaidPesewas Int
  changePesewas     Int       @default(0)
  balanceDuePesewas Int       @default(0)
  status            String    @default("PAID")
  voidedAt          DateTime?
  voidReason        String?
  voidedByUserId    String?
  items             Json
  payments          Json
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  receiptPayments   Payment[]
  booking           Booking?  @relation(fields: [bookingId], references: [id])
  cashier           User      @relation("ReceiptCashier", fields: [cashierId], references: [id], onDelete: Cascade)
  customer          Customer? @relation(fields: [customerId], references: [id])
  voidedByUser      User?     @relation("ReceiptVoider", fields: [voidedByUserId], references: [id])

  @@index([receiptNumber])
  @@index([bookingId])
  @@index([customerId])
  @@index([cashierId])
  @@index([status])
  @@index([createdAt])
}

model SelfServiceOtp {
  id        String   @id
  reference String
  phone     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([reference, phone])
}

enum BookingStatus {
  HELD
  PENDING_PAYMENT
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum BookingSource {
  WEB
  POS
  WALK_IN
}

enum DepositType {
  NONE
  FULL
  PERCENTAGE
  FIXED
}

enum PaymentRequestStatus {
  PENDING
  SENT
  VIEWED
  PAID
  FAILED
  EXPIRED
  CANCELLED
}

// -----------------------------------------------------------------------------
// Hotel Domain Models & Enums
// -----------------------------------------------------------------------------

model RoomType {
  id               String            @id @default(uuid())
  name             String
  slug             String            @unique
  description      String?
  maxAdults        Int               @default(2)
  maxChildren      Int               @default(0)
  bedConfiguration String
  basePricePesewas Int
  amenities        String[]          @default([])
  imageUrls        String[]          @default([])
  isActive         Boolean           @default(true)
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  rooms            Room[]
  rateOverrides    RateOverride[]
  reservationRooms ReservationRoom[]
  roomHolds        RoomHold[]

  @@index([slug])
  @@index([isActive])
}

model Room {
  id                String             @id @default(uuid())
  number            String             @unique
  floor             Int?
  roomTypeId        String
  status            RoomStatus         @default(CLEAN)
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  roomType          RoomType           @relation(fields: [roomTypeId], references: [id])
  reservationRooms  ReservationRoom[]
  housekeepingTasks HousekeepingTask[]

  @@index([roomTypeId])
  @@index([status])
}

model RateOverride {
  id           String    @id @default(uuid())
  roomTypeId   String
  startDate    DateTime  @db.Date
  endDate      DateTime  @db.Date
  pricePesewas Int
  minNights    Int?
  label        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  roomType     RoomType  @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([roomTypeId, startDate, endDate])
}

model RoomExtra {
  id                String             @id @default(uuid())
  name              String
  pricePesewas      Int
  pricing           RoomExtraPricing   @default(PER_STAY)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  reservationExtras ReservationExtra[]

  @@index([isActive])
}

model Reservation {
  id                     String            @id @default(uuid())
  reference              String            @unique
  guestId                String
  checkInDate            DateTime          @db.Date
  checkOutDate           DateTime          @db.Date
  adults                 Int               @default(1)
  children               Int               @default(0)
  status                 ReservationStatus @default(PENDING_PAYMENT)
  subtotalPesewas        Int
  taxPesewas             Int               @default(0)
  totalPesewas           Int
  depositRequiredPesewas Int               @default(0)
  amountPaidPesewas      Int               @default(0)
  source                 ReservationSource @default(WEBSITE)
  notes                  String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  guest                  Customer          @relation(fields: [guestId], references: [id])
  rooms                  ReservationRoom[]
  extras                 ReservationExtra[]
  folios                 Folio[]

  @@index([reference])
  @@index([guestId])
  @@index([status])
  @@index([checkInDate, checkOutDate])
}

model ReservationRoom {
  id                   String            @id @default(uuid())
  reservationId        String            @map("reservation_id")
  roomTypeId           String            @map("room_type_id")
  roomId               String?           @map("room_id")
  checkIn              DateTime          @map("check_in") @db.Date
  checkOut             DateTime          @map("check_out") @db.Date
  status               ReservationStatus @default(PENDING_PAYMENT)
  nightlyRatesSnapshot Json              @map("nightly_rates_snapshot")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  roomType    RoomType    @relation(fields: [roomTypeId], references: [id])
  room        Room?       @relation(fields: [roomId], references: [id])

  @@index([reservationId])
  @@index([roomTypeId])
  @@index([roomId])
  @@index([status])
  @@index([checkIn, checkOut])
}

model ReservationExtra {
  id            String      @id @default(uuid())
  reservationId String
  extraId       String
  quantity      Int         @default(1)
  pricePesewas  Int
  totalPesewas  Int
  createdAt     DateTime    @default(now())
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  extra         RoomExtra   @relation(fields: [extraId], references: [id])

  @@index([reservationId])
  @@index([extraId])
}

model RoomHold {
  id         String   @id @default(uuid())
  token      String   @unique
  roomTypeId String
  checkIn    DateTime @db.Date
  checkOut   DateTime @db.Date
  quantity   Int      @default(1)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([roomTypeId, checkIn, checkOut])
  @@index([expiresAt])
}

model HousekeepingTask {
  id               String                 @id @default(uuid())
  roomId           String
  assignedToUserId String?
  status           HousekeepingTaskStatus @default(PENDING)
  notes            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  room             Room                   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignedTo       User?                  @relation("HousekeepingAssignee", fields: [assignedToUserId], references: [id])

  @@index([roomId])
  @@index([assignedToUserId])
  @@index([status])
}

model Folio {
  id            String        @id @default(uuid())
  folioNumber   String        @unique
  reservationId String?
  status        FolioStatus   @default(OPEN)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  reservation   Reservation?  @relation(fields: [reservationId], references: [id])
  charges       FolioCharge[]

  @@index([folioNumber])
  @@index([reservationId])
  @@index([status])
}

model FolioCharge {
  id              String            @id @default(uuid())
  folioId         String
  description     String
  source          FolioChargeSource
  amountPesewas   Int
  referenceId     String?
  createdByUserId String?
  createdAt       DateTime          @default(now())
  folio           Folio             @relation(fields: [folioId], references: [id], onDelete: Cascade)
  createdByUser   User?             @relation("FolioChargeCreator", fields: [createdByUserId], references: [id])

  @@index([folioId])
  @@index([source])
}

enum RoomStatus {
  CLEAN
  DIRTY
  INSPECTED
  OCCUPIED
  OUT_OF_ORDER
}

enum RoomExtraPricing {
  PER_STAY
  PER_NIGHT
  PER_PERSON
}

enum ReservationStatus {
  HELD
  PENDING_PAYMENT
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum ReservationSource {
  WEBSITE
  FRONT_DESK
}

enum HousekeepingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FolioStatus {
  OPEN
  SETTLED
  VOID
}

enum FolioChargeSource {
  ROOM
  RESTAURANT
  EXTRA
  ADJUSTMENT
  PAYMENT
}
